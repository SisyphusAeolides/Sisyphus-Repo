post_install() {
  echo "==> rustd-resolved owns host DNS (NSS + stub resolv.conf)."
  if [[ -f /etc/nsswitch.conf ]] && ! grep -Eq '\bresolve\b' /etc/nsswitch.conf; then
    echo "    Add 'resolve [!UNAVAIL=return]' ahead of 'dns' in /etc/nsswitch.conf hosts: lines."
  fi
}

post_upgrade() {
  post_install
}
