# Maintainer: Kenny Glowner <SisyphusAeolides@pm.me>
pkgname=rustd-resolved
pkgver=0.2.2
pkgrel=1
_commit=b266df53a701718dae2ba586d8ec462b4d94c872
pkgdesc="Compatibility-oriented Rust reimplementation of systemd-resolved"
arch=('x86_64')
url="https://github.com/SisyphusAeolides/rustd-resolved"
license=('LGPL-2.1-or-later')
depends=('glibc' 'gcc-libs' 'openssl' 'systemd' 'liburing')
makedepends=('cargo' 'git' 'gcc-fortran' 'liburing')
provides=('systemd-resolved')
conflicts=('systemd-resolved' 'systemd-resolved-git' 'rustd-resolved-git')
replaces=('systemd-resolved' 'systemd-resolved-git' 'rustd-resolved-git')
source=("git+${url}.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
  cd "$pkgname"
  make build
}

package() {
  cd "$pkgname"
  make DESTDIR="$pkgdir" PREFIX=/usr install
}
