# Maintainer: Kenny Glowner <SisyphusAeolides@pm.me>
pkgname=iwchaos
pkgver=0.1.0
pkgrel=12
_commit=4ae75ad502f29119d9a1d74607a1b0ca7c838adf
pkgdesc="Complete iwlwifi replacement with chaos-enhanced Intel Wi-Fi driver (AX200/AX201)"
arch=('x86_64')
url="https://github.com/SisyphusAeolides/iwchaos"
license=('GPL-2.0-only')
depends=(
  'binutils'
  'clang'
  'curl'
  'dkms'
  'gcc'
  'gcc-fortran'
  'kmod'
  'llvm'
  'patch'
  'python3'
  'rust'
)
makedepends=('git' 'rsync' 'tar')
provides=('iwlwifi' 'iwlmvm')
conflicts=('iwlwifi' 'iwlmvm')
options=(!lto !debug)
source=("git+${url}.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
  cd "$pkgname"
  if [ ! -f vendor/iwlwifi/iwl-drv.c ]; then
    mkdir -p vendor/iwlwifi
    curl -sL "https://github.com/torvalds/linux/archive/refs/tags/v7.2.tar.gz" \
      | tar -xz --strip-components=6 -C vendor/iwlwifi \
        "linux-7.2/drivers/net/wireless/intel/iwlwifi/"
  fi
  if ! grep -q iwchaos_iwlwifi_init vendor/iwlwifi/iwl-drv.c 2>/dev/null; then
    ./scripts/apply-vendor-patches.sh
  fi
}

package() {
  cd "$pkgname"
  local _dest="$pkgdir/usr/src/${pkgname}-${pkgver}"

  install -dm755 "$_dest"
  rsync -a \
    --exclude='.git' \
    --exclude='.github' \
    --exclude='rust/target' \
    --exclude='chaos-math/target' \
    --exclude='rust/.ar-extract' \
    --exclude='*.o' \
    --exclude='*.ko' \
    --exclude='*.BTF.*' \
    --exclude='pkg' \
    --exclude='src' \
    ./ "$_dest/"

  install -Dm644 dkms.conf "$_dest/dkms.conf"
  install -Dm644 modprobe.d/iwchaos.conf \
    "$pkgdir/usr/lib/modprobe.d/iwchaos.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm755 scripts/swap-iwchaos.sh "$pkgdir/usr/bin/iwchaos-swap"
  install -Dm755 scripts/restore-iwlwifi.sh "$pkgdir/usr/bin/iwchaos-restore"
}
