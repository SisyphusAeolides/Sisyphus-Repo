# Maintainer: Kenny Glowner <SisyphusAeolides@pm.me>
pkgname=ccze-rs
pkgver=0.5.2
pkgrel=1
pkgdesc="Fast streaming log colorizer with native analytics and formally specified protocol verification"
arch=('x86_64')
url="https://github.com/SisyphusAeolides/ccze-rs"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'git' 'gcc-fortran')
provides=('ccze')
conflicts=('ccze' 'ccze-rs-git')
replaces=('ccze' 'ccze-rs-git')
options=(!lto)
source=("git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
  cd "$pkgname"
  make build
}

package() {
  cd "$pkgname"
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
