# Maintainer: Kenny Glowner <SisyphusAeolides@pm.me>
pkgname=libinput-rs
pkgver=0.3.2
pkgrel=1
pkgdesc="100% drop-in Rust replacement for the libinput 1.31.3 C ABI and tools"
arch=('x86_64')
url="https://github.com/SisyphusAeolides/libinput-rs"
license=('MIT')
depends=('glibc' 'gcc-libs' 'systemd-libs' 'libevdev' 'mtdev' 'python-libevdev' 'python-pyudev' 'python-yaml')
makedepends=('cargo' 'git' 'gcc-fortran' 'meson' 'curl' 'patch' 'rpm-tools')
provides=('libinput')
conflicts=('libinput' 'libinput-rs-git')
replaces=('libinput' 'libinput-rs-git')
source=("git+${url}.git#tag=v${pkgver}")
sha256sums=('SKIP')

build() {
  cd "$pkgname"
  make all
}

package() {
  cd "$pkgname"
  make DESTDIR="$pkgdir" PREFIX=/usr LIBDIR=/usr/lib install
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
