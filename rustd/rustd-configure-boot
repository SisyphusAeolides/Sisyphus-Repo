#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# Rewrite the primary bootloader entry to exclusive RustD PID1.
set -euo pipefail

CONF="${RUSTD_BOOT_CONF:-/usr/lib/rustd/boot/rustd-boot-entry.conf}"
LOADER_DIR="${RUSTD_LOADER_ENTRIES:-/boot/loader/entries}"

if [[ ! -r "$CONF" ]]; then
  echo "rustd-configure-boot: missing $CONF" >&2
  exit 1
fi

rewrite_options() {
  local line="$1"
  local opts="${line#options}"
  opts="$(echo "$opts" | sed -E 's/(^|[[:space:]])init=[^[:space:]]+//g')"
  opts="$(echo "$opts" | sed -E 's/(^|[[:space:]])rustd\.unit=[^[:space:]]+//g')"
  echo "options${opts} init=/usr/lib/rustd/rustd rustd.unit=default.target"
}

if [[ -d "$LOADER_DIR" ]]; then
  base_entry="$(ls -1t "$LOADER_DIR"/*.conf 2>/dev/null | grep -v rustd-certification | head -n1 || true)"
  if [[ -z "$base_entry" ]]; then
    echo "rustd-configure-boot: no existing loader entries to rewrite" >&2
    exit 0
  fi
  tmp="${base_entry}.rustd.tmp"
  {
    echo "# Rewritten by rustd-configure-boot — exclusive RustD PID1"
    while IFS= read -r line; do
      case "$line" in
        options*)
          rewrite_options "$line"
          ;;
        *)
          echo "$line"
          ;;
      esac
    done <"$base_entry"
  } >"$tmp"
  mv "$tmp" "$base_entry"
  # Remove obsolete side-by-side certification entry if present.
  rm -f "$LOADER_DIR/rustd-certification.conf" \
        "$LOADER_DIR/.rustd-systemd-rollback"
  echo "rustd-configure-boot: rewrote $base_entry for exclusive RustD"
  exit 0
fi

GRUB_DIR="${RUSTD_GRUB_DIR:-/etc/grub.d}"
if [[ -d "$GRUB_DIR" ]]; then
  rm -f "$GRUB_DIR/09_rustd_certification"
  install -Dm755 /dev/stdin "$GRUB_DIR/08_rustd_exclusive" <<'EOF'
#!/bin/sh
exec tail -n +3 $0
# Exclusive RustD boot — stock systemd entry must not remain default.
menuentry 'RustD' --class rustd {
  linux /vmlinuz-linux init=/usr/lib/rustd/rustd rustd.unit=default.target
  initrd /initramfs-linux.img
}
EOF
  echo "rustd-configure-boot: installed exclusive GRUB snippet $GRUB_DIR/08_rustd_exclusive"
  exit 0
fi

echo "rustd-configure-boot: no bootloader entries directory; skip" >&2
exit 0
