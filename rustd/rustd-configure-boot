#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later
# Configure a side-by-side RustD boot entry and preserve systemd rollback.
set -euo pipefail

CONF="${RUSTD_BOOT_CONF:-/usr/lib/rustd/boot/rustd-boot-entry.conf}"
LOADER_DIR="${RUSTD_LOADER_ENTRIES:-/boot/loader/entries}"
RUSTD_ENTRY="${LOADER_DIR}/rustd-certification.conf"
ROLLBACK_MARKER="${LOADER_DIR}/.rustd-systemd-rollback"

if [[ ! -r "$CONF" ]]; then
  echo "rustd-configure-boot: missing $CONF" >&2
  exit 1
fi

if [[ ! -d "$LOADER_DIR" ]]; then
  # Non-systemd-boot layouts (GRUB) get a drop-in snippet instead.
  GRUB_DIR="${RUSTD_GRUB_DIR:-/etc/grub.d}"
  if [[ -d "$GRUB_DIR" ]]; then
    install -Dm755 /dev/stdin "$GRUB_DIR/09_rustd_certification" <<'EOF'
#!/bin/sh
exec tail -n +3 $0
# RustD certification alternate boot (offline systemd rollback remains default)
menuentry 'RustD (certification)' {
  linux /vmlinuz-linux init=/usr/lib/rustd/rustd rustd.unit=default.target
  initrd /initramfs-linux.img
}
EOF
    echo "rustd-configure-boot: installed GRUB snippet $GRUB_DIR/09_rustd_certification"
    exit 0
  fi
  echo "rustd-configure-boot: no bootloader entries directory; skip" >&2
  exit 0
fi

# Prefer cloning the newest existing entry so kernel/initrd paths stay accurate.
base_entry="$(ls -1t "$LOADER_DIR"/*.conf 2>/dev/null | head -n1 || true)"
if [[ -z "$base_entry" ]]; then
  echo "rustd-configure-boot: no existing loader entries to clone" >&2
  exit 0
fi

{
  echo "# Generated by rustd-configure-boot — RustD certification entry"
  echo "# Rollback: boot the stock systemd entry (${base_entry##*/})"
  while IFS= read -r line; do
    case "$line" in
      title*)
        echo "title   RustD (certification)"
        ;;
      options*)
        # Strip any prior init= and append RustD init.
        opts="${line#options}"
        opts="$(echo "$opts" | sed -E 's/(^|[[:space:]])init=[^[:space:]]+//g')"
        echo "options${opts} init=/usr/lib/rustd/rustd rustd.unit=default.target"
        ;;
      *)
        echo "$line"
        ;;
    esac
  done <"$base_entry"
} >"$RUSTD_ENTRY"

printf '%s\n' "$base_entry" >"$ROLLBACK_MARKER"
echo "rustd-configure-boot: wrote $RUSTD_ENTRY (rollback via ${base_entry##*/})"
