pkgbase = rustd
	pkgdesc = RustD native init and service manager
	pkgver = 0.1.2
	pkgrel = 6
	url = https://github.com/SisyphusAeolides/rustd
	arch = x86_64
	license = LGPL-2.1-or-later
	makedepends = cargo
	makedepends = git
	makedepends = gcc-fortran
	makedepends = dbus
	makedepends = pam
	options = !lto
	source = git+https://github.com/SisyphusAeolides/rustd.git#commit=a50abcb6c23c0f69c5fe4e156a1a0e7db32b32d7
	source = rustd-boot-entry.conf
	source = rustd-configure-boot
	source = rustd-udev.install
	source = rustd-udev.hook
	source = native-libs.patch
	sha256sums = SKIP
	sha256sums = b42a92cb8a8d5c9208ba82d32a9d65fc2e77d05e4d860ea0e2bb799238e3bb8e
	sha256sums = 3da2e2d113daa68727ad298a5914f2635bf1f56da411884d63ee358d0ad5ea39
	sha256sums = 304967b6406dbee254d3b2ba432f287df633d10c1742bf90485d1eb65f308e61
	sha256sums = 9b99f4a525f89847c3cb9981e3e7351e74795423499c0ed75f1fd22bd1e3aa98
