pkgname = rustd
	pkgdesc = RustD native init and service manager
	install = rustd.install
	depends = glibc
	depends = gcc-libs
	depends = openssl
	depends = libcap
	depends = libseccomp
	depends = pam
	depends = dbus
	depends = audit
	depends = libxcrypt
	depends = pcre2
	depends = rustd-libs
	conflicts = rustd-git

pkgname = rustd-libs
	pkgdesc = RustD native shared libraries (service/journal/device/login/manager)
	depends = glibc

pkgname = rustd-compat
	pkgdesc = Preview libsystemd/libudev shims over librustd_* (not a systemd-libs replacement)
	depends = glibc
	depends = rustd-libs

pkgname = rustd-devel
	pkgdesc = RustD native C headers and pkg-config files
	depends = rustd-libs
