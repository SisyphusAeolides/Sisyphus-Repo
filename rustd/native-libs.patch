+    local exe resolved comm unsafe=0
+    if [[ "$ROOT" != "/" ]]; then
+        pending "live-process scan requires RUSTD_CUTOVER_ROOT=/"
+        return
+    fi
+    for exe in /proc/[0-9]*/exe; do
+        [[ -e "$exe" ]] || continue
+        resolved="$(readlink -f -- "$exe" 2>/dev/null || true)"
+        [[ -n "$resolved" ]] || continue
