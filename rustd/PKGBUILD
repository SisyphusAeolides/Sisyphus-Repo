# Maintainer: Kenny Glowner <SisyphusAeolides@pm.me>
pkgname=rustd
pkgver=0.1.1
pkgrel=1
_commit=2262e461ee4b70e27dac0ed6ad0420ef3bd99d16
pkgdesc="Compatibility-oriented reimplementation of systemd"
arch=('x86_64')
url="https://github.com/SisyphusAeolides/rustd"
license=('LGPL-2.1-or-later')
depends=('glibc' 'gcc-libs' 'openssl' 'libcap' 'libseccomp' 'pam' 'dbus' 'audit' 'libxcrypt' 'pcre2')
makedepends=('cargo' 'git' 'gcc-fortran')
provides=('systemd')
conflicts=('systemd' 'systemd-git' 'rustd-git')
replaces=('systemd-git' 'rustd-git')
source=("git+${url}.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
  cd "$pkgname"
  make build
}

package() {
  cd "$pkgname"
  make DESTDIR="$pkgdir" PREFIX=/usr install
}
