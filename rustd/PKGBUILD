# Maintainer: Kenny Glowner <SisyphusAeolides@pm.me>
pkgname=rustd
pkgver=0.1.2
pkgrel=1
# Exact signed SHA promoted for exclusive CachyOS replacement.
_commit=19d4e17603711807cb8bce873adeb47beca4a873
pkgdesc="RustD init and service manager (exclusive systemd replacement)"
arch=('x86_64')
url="https://github.com/SisyphusAeolides/rustd"
license=('LGPL-2.1-or-later')
depends=('glibc' 'gcc-libs' 'openssl' 'libcap' 'libseccomp' 'pam' 'dbus' 'audit' 'libxcrypt' 'pcre2' 'systemd-libs')
makedepends=('cargo' 'git' 'gcc-fortran' 'dbus' 'pam')
provides=('systemd' 'udev' 'systemd-tools')
conflicts=('systemd' 'rustd-git')
replaces=('systemd')
install=rustd.install
source=("git+${url}.git#commit=${_commit}"
        "rustd-boot-entry.conf"
        "90-rustd-boot.hook"
        "rustd-configure-boot")
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

build() {
  cd "$pkgname"
  make build pam-module
}

check() {
  cd "$pkgname"
  make check-native
  make check-packaging
}

package() {
  cd "$pkgname"
  make DESTDIR="$pkgdir" PREFIX=/usr install

  # Pacman hooks and third-party packages still invoke systemctl(1).
  ln -sf rustctl "$pkgdir/usr/bin/systemctl"
  ln -sf rustctl "$pkgdir/usr/bin/journalctl"
  ln -sf rustudevadm "$pkgdir/usr/bin/udevadm"

  # Exclusive boot integration: rewrite the primary boot entry to RustD PID1.
  install -Dm644 "$srcdir/rustd-boot-entry.conf" \
    "$pkgdir/usr/lib/rustd/boot/rustd-boot-entry.conf"
  install -Dm755 "$srcdir/rustd-configure-boot" \
    "$pkgdir/usr/lib/rustd/boot/rustd-configure-boot"
  install -Dm644 "$srcdir/90-rustd-boot.hook" \
    "$pkgdir/usr/share/libalpm/hooks/90-rustd-boot.hook"

  printf '%s\n' "$_commit" >"$pkgdir/usr/lib/rustd/CERTIFIED_COMMIT"
  install -Dm644 /dev/null "$pkgdir/usr/lib/rustd/.exclusive-replacement"
}
