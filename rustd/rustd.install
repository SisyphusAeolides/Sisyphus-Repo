post_install() {
  echo "==> RustD exclusive replacement installed (conflicts with systemd)."
  echo "    Primary boot entry will use init=/usr/lib/rustd/rustd."
  echo "    Keep a CachyOS rescue USB until the first graphical boot succeeds."

  # Prefer classic mkinitcpio udev hooks once systemd is gone.
  if [[ -f /etc/mkinitcpio.conf ]]; then
    if grep -Eq 'HOOKS=.*\bsystemd\b' /etc/mkinitcpio.conf; then
      sed -i -E \
        -e 's/\bsystemd\b/udev/' \
        -e 's/\bsd-vconsole\b/vconsole/' \
        -e 's/\bsd-encrypt\b/encrypt/' \
        /etc/mkinitcpio.conf || true
      echo "==> Updated /etc/mkinitcpio.conf: systemd hooks -> udev/vconsole/encrypt"
    fi
  fi

  /usr/lib/rustd/boot/rustd-configure-boot || true
}

post_upgrade() {
  post_install
}

pre_remove() {
  echo "==> Removing RustD exclusive replacement."
  echo "    Restore a stock CachyOS/systemd image before rebooting without RustD."
}
