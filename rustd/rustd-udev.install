#!/usr/bin/bash

build() {
    map add_binary \
        /usr/lib/rustd/rustd-udevd \
        /usr/bin/rustudevadm \
        /usr/bin/rustd-tmpfiles \
        /usr/lib/libkmod.so.2

    map add_udev_rule \
        50-udev-default.rules \
        60-persistent-storage.rules \
        64-btrfs.rules \
        80-drivers.rules

    for file in /usr/lib/udev/hwdb.bin /etc/udev/hwdb.bin; do
        [[ ! -f "$file" ]] || add_file "$file"
    done

    add_runscript
}

help() {
    cat <<'EOF'
This hook starts rustd-udevd in a busybox-based initramfs and triggers the
coldplug events needed to discover the root filesystem.
EOF
}
