#!/usr/bin/ash

run_earlyhook() {
    kmod static-nodes --format=tmpfiles --output=/run/tmpfiles.d/kmod.conf
    rustd-tmpfiles --prefix=/dev --create --boot
    /usr/lib/rustd/rustd-udevd --daemon &
    udevd_running=1
}

run_hook() {
    msg ":: Triggering uevents with rustd-udevd..."
    rustudevadm trigger --action=add --type=subsystems
    rustudevadm trigger --action=add --type=devices
    rustudevadm settle
}

run_cleanuphook() {
    rustudevadm control --exit
    rustudevadm info --cleanup-db
}
