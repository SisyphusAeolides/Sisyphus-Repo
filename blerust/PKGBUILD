# Maintainer: Kenny Glowner <SisyphusAeolides@pm.me>
pkgname=blerust
pkgver=0.1.15
pkgrel=1
_commit=7d3085120b127aea32cf3c92acc716818a1753aa
pkgdesc="Blazing fast and robust line editor in Rust (replacement for blesh)"
arch=('x86_64')
url="https://github.com/SisyphusAeolides/blerust"
license=('MIT')
depends=('gcc-libs' 'glibc')
makedepends=('cargo' 'git')
provides=('blerust' 'blesh')
conflicts=('blesh' 'blesh-git')
options=(!lto)
source=("git+${url}.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
  cd "$pkgname"
  cargo build --release --locked
}

package() {
  cd "$pkgname"
  install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
}
