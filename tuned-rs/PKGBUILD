# Maintainer: Kenny Glowner <SisyphusAeolides@pm.me>
pkgname=tuned-rs
pkgver=0.2.10
pkgrel=2
_commit=4ef6c39f639891cdc7842f489cbd8fa42466212b
pkgdesc="High-performance Rust implementation of the TuneD system tuning daemon"
arch=('x86_64')
url="https://github.com/SisyphusAeolides/tuned-rs"
license=('GPL2')
depends=('glibc' 'gcc-libs' 'systemd-libs')
makedepends=('cargo' 'git')
provides=('power-profiles-daemon' 'tuned')
conflicts=('power-profiles-daemon' 'tuned' 'tuned-rs-git')
replaces=('power-profiles-daemon' 'tuned' 'tuned-rs-git')
source=("git+${url}.git#commit=${_commit}")
sha256sums=('SKIP')

build() {
  cd "$pkgname"
  make build
}

package() {
  cd "$pkgname"
  make DESTDIR="$pkgdir" PREFIX=/usr SBINDIR=/usr/bin install
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
