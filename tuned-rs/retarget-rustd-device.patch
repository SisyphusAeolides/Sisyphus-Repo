+        bail!("rustd_device enumerate scan failed");
+    }
+
+    let mut names = BTreeSet::new();
+    let mut entry = unsafe { rustd_device_enumerate_get_list_entry(enumerate) };
+    while !entry.is_null() {
+        let syspath = unsafe { rustd_device_list_entry_get_name(entry) };
+        if let Some(syspath) = cstr_to_string(syspath) {
+            if let Ok(syspath_c) = CString::new(syspath) {
+                let device = unsafe { rustd_device_new_from_syspath(ctx, syspath_c.as_ptr()) };
+                if !device.is_null() {
+                    let rejected = regex.as_ref().is_some_and(|regex| {
+                        let mut properties = Vec::new();
+                        let mut prop = unsafe { rustd_device_get_properties_list_entry(device) };
+                        while !prop.is_null() {
+                            if let (Some(name), Some(value)) = (
+                                cstr_to_string(unsafe { rustd_device_list_entry_get_name(prop) }),
+                                cstr_to_string(unsafe { rustd_device_list_entry_get_value(prop) }),
+                            ) {
+                                properties.push((name, value));
+                            }
+                            prop = unsafe { rustd_device_list_entry_get_next(prop) };
+                        }
+                        properties.sort_unstable();
+                        let text = properties.into_iter().fold(
+                            String::new(),
+                            |mut text, (name, value)| {
+                                let _ = writeln!(text, "{name}={value}");
+                                text
+                            },
+                        );
+                        !regex.is_match(&text)
+                    });
+                    if !rejected {
+                        if let Some(name) =
+                            cstr_to_string(unsafe { rustd_device_get_sysname(device) })
+                        {
+                            names.insert(name);
+                        }
+                    }
+                    unsafe {
+                        rustd_device_unref(device);
+                    }
+                }
+            }
         }
+        entry = unsafe { rustd_device_list_entry_get_next(entry) };
+    }
+
+    unsafe {
+        rustd_device_enumerate_unref(enumerate);
+        rustd_device_ctx_unref(ctx);
     }
     Ok(names.into_iter().collect())
 }
