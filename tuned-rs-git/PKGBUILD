# Maintainer: Kenny Glowner <SisyphusAeolides@pm.me>
pkgname=tuned-rs-git
pkgver=0.2.6
pkgrel=2
pkgdesc="High-performance Rust implementation of the TuneD system tuning daemon"
arch=('x86_64')
url="https://github.com/SisyphusAeolides/tuned-rs"
license=('GPL2')
depends=('glibc' 'gcc-libs' 'systemd-libs')
makedepends=('cargo' 'git')
provides=("${pkgname%-git}" "power-profiles-daemon" "tuned")
conflicts=("${pkgname%-git}" "power-profiles-daemon" "tuned")
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "${pkgname%-git}"
  echo "$(grep '^version =' Cargo.toml | head -n1 | cut -d\" -f2).r$(git rev-list --count HEAD).g$(git rev-parse --short HEAD)"
}

build() {
  cd "${pkgname%-git}"
  make build
}

package() {
  cd "${pkgname%-git}"
  make DESTDIR="$pkgdir" PREFIX=/usr SBINDIR=/usr/bin install
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/${pkgname%-git}/LICENSE"
}
